# Copy this file to `.env` and fill in your own keys.

SECRET_KEY=change-this-to-a-random-secret-string

# Get a free key at https://openweathermap.org/api
OPEN_WEATHER_APIKEY=your_openweathermap_key_here

# Only needed if you use HuggingFace-hosted disease model weights
HUGGINGFACE_LOGIN_TOKEN=your_huggingface_token_here
